# Empty template only: every value below must stay empty in this committed
# file (enforced by packages/app/tests/no-provider-secrets.test.ts).
# Where each key lives per environment (dev/staging/prod), and the commands
# that prove nothing here reaches a client asset, are in
# docs/deployment-runbook.md section 3 ("Secrets"), summary:
#   secret (NAN_API_KEY, JWT_PRIVATE_KEY, JWKS, *_CLIENT_SECRET) -> Convex
#     deployment variable (`npx convex env set`) and/or Cloudflare Worker
#     secret (`npx wrangler secret put`); never this file, never a bundle.
#   server config (NAN_DEPLOYER_ID, CONVEX_URL, SITE_URL,
#     AUTH_REDIRECT_URIS, MAX_UPLOAD_BYTES, INGESTION_*, RATE_LIMIT_*,
#     LOG_RETENTION_DAYS, ...) -> Convex deployment variables, or Worker vars
#     for CONVEX_URL/NAN_DEPLOYER_ID.
#   operator/CI credentials (CONVEX_DEPLOYMENT, CLOUDFLARE_API_TOKEN,
#     CLOUDFLARE_ACCOUNT_ID, CONVEX_DEPLOY_KEY) -> gitignored local .env or
#     the CI secret store only; never a Worker binding, never the browser.
#   public build-time config (VITE_*) -> baked into packages/app per
#     environment; public by design, so it must never hold a secret.
NAN_API_KEY=
# S15 STT: the deployer's Convex user id for the personal-key policy gate
# (single-user self-hosted; empty visibly blocks transcription). Optional
# provider timeout override in ms for tests; empty means the 15000 ms default.
NAN_DEPLOYER_ID=
STT_TIMEOUT_MS=
# S16 TTS: optional synthesis timeout override in ms for /tts/synthesize;
# empty means the 15000 ms default. Server-side like STT_TIMEOUT_MS.
TTS_TIMEOUT_MS=
CONVEX_DEPLOYMENT=
CONVEX_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Convex Auth (S06). Deployment variables; set with `npx convex env set <NAME> <value>`.
# Values are never committed. JWT_PRIVATE_KEY/JWKS are generated per deployment
# (see docs/adr/0004-authentication-method.md); empty means "not configured".
# SITE_URL and the origins of AUTH_REDIRECT_URIS also form the CORS allowlist
# for the S15 browser -> .convex.site route; other origins are never echoed.
# Vercel frontend origins (issue #38) are exact entries, never wildcards:
# production https://app-dun-seven-88.vercel.app, and each preview origin
# added one at a time to a preview/staging deployment only
# (docs/deployment-runbook.md section 13.5).
SITE_URL=
AUTH_REDIRECT_URIS=
JWT_PRIVATE_KEY=
JWKS=
# OAuth stays disabled until BOTH credentials of a provider are supplied.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser build: Convex deployment URL consumed by packages/app (VITE_* is public).
# On Vercel these are the ONLY names supplied to the frontend build, set per
# environment in the project settings (preview/production) before the project
# build (`pnpm run build`) runs; packages/app/vercel.json carries no values, and no secret
# name ever belongs in a browser build. Offline proof: the dist/ grep in
# docs/deployment-runbook.md sections 7 (5) and 13.4.
VITE_CONVEX_URL=
# Optional explicit HTTP-actions origin for the S15 STT route; when empty the
# app derives https://<deployment>.convex.site from VITE_CONVEX_URL.
VITE_CONVEX_SITE_URL=
# Document upload cap in bytes (S08). Empty falls back to the 10 MiB product
# cap; any value above 10485760 is clamped down, never raised.
MAX_UPLOAD_BYTES=
# Ingestion runner (S09). Deployment variables; set with `npx convex env set <NAME> <value>`.
# Empty falls back to the default; a non-integer or out-of-range value is ignored,
# never trusted. None of these may raise the upload cap or bypass an ownership check.
INGESTION_MAX_ATTEMPTS=
INGESTION_BACKOFF_BASE_MS=
INGESTION_LEASE_MS=
INGESTION_PARSE_TIMEOUT_MS=
# Source-aware chunking (S10), in characters of chunk text. Size defaults to
# 1000 (64..8000; larger clamps, smaller/malformed falls back), overlap to 100
# (0..size-1; an overlap >= size clamps to size-1). Treated as a deployment
# constant: changing it while a document's job already committed rows fails
# that replay visibly with CHUNK_CONFLICT instead of mixing generations.
INGESTION_CHUNK_SIZE=
INGESTION_CHUNK_OVERLAP=
# S24 bounded observability, rate limits and privacy lifecycle. Deployment
# variables; empty, malformed or out-of-range values fall back to the defaults
# below and can never disable an authorization or ownership check.
# Per-learner request rate across the costly HTTP routes: this many requests
# per window (default 60 per 60 seconds, clamped 1..10000 / 1..3600 s).
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=
# Server-side audio-duration budget in seconds, read from the container header
# before any provider request (default 60, clamped 5..600). The 8 MiB byte cap
# and the browser's 60 s recording budget still apply.
MAX_AUDIO_DURATION_SECONDS=
# Per-learner cap on simultaneously running tutor turns (default 3, clamped 1..10).
MAX_CONCURRENT_TURNS=
# Telemetry retention in days (default 30, clamped 1..365). The hourly cleanup
# cron deletes expired rows in bounded batches (rotation/cleanup).
LOG_RETENTION_DAYS=
